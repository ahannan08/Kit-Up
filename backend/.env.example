# Copy to `.env` in this folder and fill in values.
# File: backend/.env

# MongoDB (required)
# Atlas: Cluster → Connect → Drivers → copy mongodb+srv://...
# Include database name in the path, e.g. ...mongodb.net/kitup?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USER:PASSWORD@kitupCluster25.xxxxx.mongodb.net/kitup?retryWrites=true&w=majority

PORT=3009

JWT_SECRET=bpQQNGkC3CHW26GVw5N43D4cvpwMFNpnQ37/gP9paQM=

STRIPE_SECRET_KEY=sk_test_your_key_here

# Optional kit prices in INR (defaults: Home 700, Away 500)
# HOME_KIT_PRICE=700
# AWAY_KIT_PRICE=500
